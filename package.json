{
  "name": "errtraq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.node-tests.json --noEmit",
    "lint": "biome check . && node scripts/check-layering.mjs && node scripts/check-exports.mjs",
    "test": "vitest run",
    "build": "tsc -b",
    "e2e": "pnpm build && node scripts/e2e.mjs",
    "infra:validate": "node scripts/infra-validate.mjs",
    "infra:mutate": "node scripts/infra-mutate.mjs",
    "container:check": "node scripts/container-check.mjs",
    "aws-emulator:install": "node scripts/aws-emulated/install.mjs",
    "test:aws-emulated": "node scripts/aws-emulated/run.mjs",
    "infra:probe-emulated": "node scripts/aws-emulated/probe-terraform.mjs",
    "infra:apply-emulated": "node scripts/aws-emulated/apply-emulated.mjs",
    "aws-emulator:install-s3-patched": "node scripts/aws-emulated/install-s3-patched.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@errtraq/blob-fs": "workspace:*",
    "@errtraq/blob-s3": "workspace:*",
    "@errtraq/cli": "workspace:*",
    "@errtraq/core": "workspace:*",
    "@errtraq/kv-dynamodb": "workspace:*",
    "@errtraq/kv-memory": "workspace:*",
    "@errtraq/platform-aws-lambda": "workspace:*",
    "@errtraq/platform-standalone": "workspace:*",
    "@errtraq/queue-memory": "workspace:*",
    "@errtraq/queue-sqs": "workspace:*",
    "@errtraq/store-dynamodb": "workspace:*",
    "@errtraq/store-sql": "workspace:*",
    "@sentry/node": "^11.15.0",
    "@types/node": "^26.6.6",
    "typescript": "~5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
