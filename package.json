{
  "name": "errtraq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.node-tests.json --noEmit",
    "lint": "biome check . && node scripts/check-layering.mjs && node scripts/check-exports.mjs",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "e2e": "pnpm build && node scripts/e2e.mjs",
    "infra:validate": "node scripts/infra-validate.mjs",
    "infra:mutate": "node scripts/infra-mutate.mjs",
    "container:check": "node scripts/container-check.mjs",
    "aws-emulator:install": "node scripts/aws-emulated/install.mjs",
    "archive:smoke": "node scripts/archive-local/smoke.mjs",
    "e2e:archive": "pnpm build && node scripts/e2e-archive.mjs",
    "test:gcs-emulated": "node scripts/gcs-emulated/run.mjs",
    "test:pubsub-emulated": "node scripts/pubsub-emulated/run.mjs",
    "test:firestore-emulated": "node scripts/firestore-emulated/run.mjs",
    "test:cloudsql-emulated": "node scripts/test-postgres-cloudsql.mjs",
    "test:aws-emulated": "node scripts/aws-emulated/run.mjs",
    "infra:probe-emulated": "node scripts/aws-emulated/probe-terraform.mjs",
    "infra:apply-emulated": "node scripts/aws-emulated/apply-emulated.mjs",
    "test:workers-smoke": "node scripts/workers-smoke.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "docs:dev": "pnpm --filter @moriyoshi/errtraq-docs dev",
    "docs:build": "pnpm --filter @moriyoshi/errtraq-docs build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@moriyoshi/errtraq-archive-iceberg": "workspace:*",
    "@moriyoshi/errtraq-blob-fs": "workspace:*",
    "@moriyoshi/errtraq-blob-gcs": "workspace:*",
    "@moriyoshi/errtraq-blob-s3": "workspace:*",
    "@moriyoshi/errtraq-cli": "workspace:*",
    "@moriyoshi/errtraq-core": "workspace:*",
    "@moriyoshi/errtraq-gcp-auth": "workspace:*",
    "@moriyoshi/errtraq-kv-dynamodb": "workspace:*",
    "@moriyoshi/errtraq-kv-firestore": "workspace:*",
    "@moriyoshi/errtraq-kv-memory": "workspace:*",
    "@moriyoshi/errtraq-platform-aws-lambda": "workspace:*",
    "@moriyoshi/errtraq-platform-cloud-run": "workspace:*",
    "@moriyoshi/errtraq-platform-standalone": "workspace:*",
    "@moriyoshi/errtraq-queue-memory": "workspace:*",
    "@moriyoshi/errtraq-queue-pubsub": "workspace:*",
    "@moriyoshi/errtraq-queue-sqs": "workspace:*",
    "@moriyoshi/errtraq-store-dynamodb": "workspace:*",
    "@moriyoshi/errtraq-store-firestore": "workspace:*",
    "@moriyoshi/errtraq-store-sql": "workspace:*",
    "@sentry/node": "^11.15.0",
    "@types/node": "^26.6.6",
    "miniflare": "4.20260730.0",
    "typescript": "~5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
