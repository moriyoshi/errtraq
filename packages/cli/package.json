{
  "name": "@moriyoshi/errtraq-cli",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./standalone-entry": {
      "development": "./src/standalone-entry.ts",
      "types": "./dist/standalone-entry.d.ts",
      "import": "./dist/standalone-entry.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./standalone-entry": {
        "types": "./dist/standalone-entry.d.ts",
        "import": "./dist/standalone-entry.js"
      }
    }
  },
  "bin": {
    "errtraq": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm --workspace-root run build"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1176.0",
    "@moriyoshi/errtraq-archive-iceberg": "workspace:*",
    "@moriyoshi/errtraq-aws-signing": "workspace:*",
    "@moriyoshi/errtraq-blob-fs": "workspace:*",
    "@moriyoshi/errtraq-gcp-auth": "workspace:*",
    "@moriyoshi/errtraq-infra-gen": "workspace:*",
    "@moriyoshi/errtraq-kv-dynamodb": "workspace:*",
    "@moriyoshi/errtraq-kv-memory": "workspace:*",
    "@moriyoshi/errtraq-platform-aws-lambda": "workspace:*",
    "@moriyoshi/errtraq-platform-cloud-run": "workspace:*",
    "@moriyoshi/errtraq-platform-standalone": "workspace:*",
    "@moriyoshi/errtraq-queue-memory": "workspace:*",
    "@moriyoshi/errtraq-store-dynamodb": "workspace:*",
    "@moriyoshi/errtraq-store-sql": "workspace:*",
    "@moriyoshi/errtraq-terraform-modules": "workspace:*",
    "@smithy/shared-ini-file-loader": "^4.7.2",
    "esbuild": "0.28.2",
    "fflate": "0.8.2"
  },
  "peerDependencies": {
    "@moriyoshi/errtraq-core": "workspace:^"
  },
  "devDependencies": {
    "@moriyoshi/errtraq-core": "workspace:*",
    "@moriyoshi/errtraq-testing": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moriyoshi/errtraq.git",
    "directory": "packages/cli"
  }
}
