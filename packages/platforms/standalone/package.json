{
  "name": "@errtraq/platform-standalone",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stack": {
      "development": "./src/stack.ts",
      "types": "./dist/stack.d.ts",
      "import": "./dist/stack.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./stack": {
        "types": "./dist/stack.d.ts",
        "import": "./dist/stack.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm --workspace-root run build"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "dependencies": {
    "@errtraq/http": "workspace:*",
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@errtraq/core": "workspace:^"
  },
  "devDependencies": {
    "@errtraq/testing": "workspace:*",
    "@errtraq/core": "workspace:*"
  }
}
