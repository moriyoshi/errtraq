{
  "name": "@errtraq/store-sql",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stack": {
      "development": "./src/stack.ts",
      "types": "./dist/stack.d.ts",
      "import": "./dist/stack.js"
    },
    "./postgres": {
      "development": "./src/postgres.ts",
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./postgres/stack": {
      "development": "./src/postgres-stack.ts",
      "types": "./dist/postgres-stack.d.ts",
      "import": "./dist/postgres-stack.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./stack": {
        "types": "./dist/stack.d.ts",
        "import": "./dist/stack.js"
      },
      "./postgres": {
        "types": "./dist/postgres.d.ts",
        "import": "./dist/postgres.js"
      },
      "./postgres/stack": {
        "types": "./dist/postgres-stack.d.ts",
        "import": "./dist/postgres-stack.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm --workspace-root run build"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "dependencies": {
    "@errtraq/aws-signing": "workspace:*",
    "kysely": "^0.29.9",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@errtraq/core": "workspace:^"
  },
  "devDependencies": {
    "@errtraq/testing": "workspace:*",
    "@types/pg": "8.15.6",
    "@errtraq/core": "workspace:*"
  }
}
