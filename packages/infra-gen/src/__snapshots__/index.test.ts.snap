{
  "main.tf.json": "{
  "//": "Generated by errtraq from stack aws-dynamodb-per-topic; do not edit.",
  "module": {
    "blob": {
      "name": "aws-dynamodb-per-topic",
      "protection": "production",
      "source": "../../modules/aws/s3",
      "staging_prefix": "archive-staging/",
      "tags": {
        "app": "errtraq"
      }
    },
    "kv": {
      "name": "aws-dynamodb-per-topic",
      "protection": "production",
      "purpose": "kv",
      "source": "../../modules/aws/dynamodb",
      "tags": {
        "app": "errtraq"
      }
    },
    "platform": {
      "cron_triggers": {},
      "functions": {
        "api": {
          "architecture": "x86_64",
          "artifact": "build/api.zip",
          "auth_type": "NONE",
          "environment": {
            "ERRTRAQ_BLOB_BUCKET": "\${module.blob.bucket_name}",
            "ERRTRAQ_STORE_TABLE": "\${module.store.table_name}"
          },
          "http": [
            "api"
          ],
          "memory_mb": 512,
          "policies": [
            "\${module.store.policies[\\"read\\"][\\"primary\\"]}",
            "\${module.store.policies[\\"write\\"][\\"primary\\"]}",
            "\${module.blob.policies[\\"read\\"][\\"primary\\"]}"
          ],
          "roles": [
            "api"
          ],
          "secret_reads": [],
          "secrets": {},
          "timeout_sec": 30
        },
        "consumer": {
          "architecture": "x86_64",
          "artifact": "build/consumer.zip",
          "auth_type": "NONE",
          "environment": {
            "ERRTRAQ_BLOB_BUCKET": "\${module.blob.bucket_name}",
            "ERRTRAQ_QUEUE_SOURCE_INGEST": "\${module.queue.queues[\\"ingest\\"][\\"arn\\"]}",
            "ERRTRAQ_STORE_TABLE": "\${module.store.table_name}"
          },
          "http": [],
          "memory_mb": 512,
          "policies": [
            "\${module.store.policies[\\"read\\"][\\"primary\\"]}",
            "\${module.store.policies[\\"write\\"][\\"primary\\"]}",
            "\${module.blob.policies[\\"read\\"][\\"primary\\"]}",
            "\${module.blob.policies[\\"write\\"][\\"primary\\"]}",
            "\${module.blob.policies[\\"delete\\"][\\"primary\\"]}",
            "\${module.queue.policies[\\"consume\\"][\\"ingest\\"]}"
          ],
          "roles": [
            "consumer"
          ],
          "secret_reads": [],
          "secrets": {},
          "timeout_sec": 30
        },
        "cron": {
          "architecture": "x86_64",
          "artifact": "build/cron.zip",
          "auth_type": "NONE",
          "environment": {
            "ERRTRAQ_BLOB_BUCKET": "\${module.blob.bucket_name}",
            "ERRTRAQ_QUEUE_INGEST_URL": "\${module.queue.queues[\\"ingest\\"][\\"url\\"]}"
          },
          "http": [],
          "memory_mb": 512,
          "policies": [
            "\${module.blob.policies[\\"read\\"][\\"primary\\"]}",
            "\${module.blob.policies[\\"list\\"][\\"primary\\"]}",
            "\${module.queue.policies[\\"produce\\"][\\"ingest\\"]}"
          ],
          "roles": [
            "cron"
          ],
          "secret_reads": [],
          "secrets": {},
          "timeout_sec": 30
        },
        "ingest": {
          "architecture": "x86_64",
          "artifact": "build/ingest.zip",
          "auth_type": "NONE",
          "environment": {
            "ERRTRAQ_BLOB_BUCKET": "\${module.blob.bucket_name}",
            "ERRTRAQ_KV_TABLE": "\${module.kv.table_name}",
            "ERRTRAQ_QUEUE_INGEST_URL": "\${module.queue.queues[\\"ingest\\"][\\"url\\"]}",
            "ERRTRAQ_STORE_TABLE": "\${module.store.table_name}"
          },
          "http": [
            "ingest"
          ],
          "memory_mb": 512,
          "policies": [
            "\${module.store.policies[\\"read\\"][\\"primary\\"]}",
            "\${module.blob.policies[\\"write\\"][\\"primary\\"]}",
            "\${module.blob.policies[\\"delete\\"][\\"primary\\"]}",
            "\${module.kv.policies[\\"read\\"][\\"primary\\"]}",
            "\${module.kv.policies[\\"write\\"][\\"primary\\"]}",
            "\${module.queue.policies[\\"produce\\"][\\"ingest\\"]}"
          ],
          "roles": [
            "ingest"
          ],
          "secret_reads": [],
          "secrets": {},
          "timeout_sec": 30
        }
      },
      "handler": "index.handler",
      "name": "aws-dynamodb-per-topic",
      "queue_triggers": {
        "ingest": {
          "batch_size": 10,
          "function_id": "consumer",
          "resource": "\${module.queue.queues[\\"ingest\\"][\\"arn\\"]}",
          "topics": [
            "ingest"
          ],
          "visibility_timeout_sec": 180
        }
      },
      "runtime": "nodejs22.x",
      "source": "../../modules/aws/lambda-app",
      "tags": {
        "app": "errtraq"
      }
    },
    "queue": {
      "name": "aws-dynamodb-per-topic",
      "physical_queues": {
        "ingest": {
          "dlq_enabled": true,
          "max_receive_count": 5,
          "visibility_timeout_sec": 180
        }
      },
      "source": "../../modules/aws/sqs",
      "tags": {
        "app": "errtraq"
      }
    },
    "store": {
      "name": "aws-dynamodb-per-topic",
      "protection": "production",
      "purpose": "store",
      "source": "../../modules/aws/dynamodb",
      "tags": {
        "app": "errtraq"
      }
    }
  }
}
",
  "outputs.tf.json": "{
  "//": "Generated by errtraq from stack aws-dynamodb-per-topic; do not edit.",
  "output": {
    "api_url": {
      "value": "\${module.platform.api_url}"
    },
    "ingest_url": {
      "value": "\${module.platform.ingest_url}"
    }
  }
}
",
  "providers.tf.json": "{
  "//": "Generated by errtraq from stack aws-dynamodb-per-topic; do not edit.",
  "provider": {
    "aws": [
      {
        "default_tags": {
          "tags": {
            "app": "errtraq"
          }
        },
        "region": "us-east-1"
      }
    ]
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": ">= 6.32.1, < 7.0"
      }
    },
    "required_version": ">= 1.9.0, < 2.0.0"
  }
}
",
  "variables.tf.json": "{
  "//": "Generated by errtraq from stack aws-dynamodb-per-topic; do not edit."
}
",
}
`;

