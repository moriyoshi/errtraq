    "file": "main.tf",
    "find": "Action = [\"dynamodb:GetItem\", \"dynamodb:BatchGetItem\", \"dynamodb:Query\"], Resource = local.table_and_indexes",
    "replace": "Action = [\"dynamodb:*\"], Resource = [\"*\"]"
  },
  {
