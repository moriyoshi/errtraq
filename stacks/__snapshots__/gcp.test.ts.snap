            "ERRTRAQ_PUSH_SERVICE_ACCOUNT": "errtraq-push@example-project.iam.gserviceaccount.com",
            "ERRTRAQ_SCHEDULER_SERVICE_ACCOUNT": "errtraq-scheduler@example-project.iam.gserviceaccount.com"
          },
          "http": [
            "api"
          ],
          "ingress": "all",
          "max_instances": 20,
          "memory_mb": 512,
          "min_instances": 0,
          "policies": [
            "\${module.store.policies[\\"read\\"][\\"primary\\"]}",
            "\${module.store.policies[\\"write\\"][\\"primary\\"]}",
            "\${module.store.policies[\\"write\\"][\\"primary\\"]}",
            "\${module.blob.policies[\\"read\\"][\\"primary\\"]}"
          ],
          "public": true,
