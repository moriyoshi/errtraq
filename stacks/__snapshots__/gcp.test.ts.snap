    "kv": {
      "database_id": null,
      "labels": {
        "app": "errtraq"
      },
      "location": "europe-west1",
      "name": "gcp-cloudsql",
      "project_id": "example-project",
      "protection": "production",
      "purpose": "kv",
      "source": "../../modules/google/firestore",
      "ttl_policies": [
        {
          "collection": "kv",
          "field": "expireAt"
        }
      ]
    },
    "platform": {
