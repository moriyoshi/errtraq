exports[`gcp-cloudsql > generates Terraform for the google provider > providers 1`] = `
"{
  "//": "Generated by errtraq from stack gcp-cloudsql; do not edit.",
  "provider": {
    "google": [
      {
        "default_labels": {
          "app": "errtraq"
        },
        "project": "example-project",
        "region": "europe-west1"
      }
    ]
  },
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": ">= 8.0.0, < 9.0, ~> 8.0"
      }
    },
    "required_version": ">= 1.9.0, < 2.0.0"
  }
}
"
`;

