            "ERRTRAQ_OIDC_AUDIENCE": "errtraq-push",
            "ERRTRAQ_POSTGRES_DATABASE": "errtraq",
            "ERRTRAQ_POSTGRES_INSTANCE": "example-project:europe-west1:example-sql",
