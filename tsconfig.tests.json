{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@errtraq/core": ["packages/core/src/index.ts"],
      "@errtraq/testing": ["packages/testing/src/index.ts"],
      "@errtraq/http": ["packages/http/src/index.ts"],
      "@errtraq/cli": ["packages/cli/src/index.ts"],
      "@errtraq/infra-gen": ["packages/infra-gen/src/index.ts"],
      "@errtraq/store-sql": ["packages/adapters/store-sql/src/index.ts"],
      "@errtraq/store-sql/stack": ["packages/adapters/store-sql/src/stack.ts"],
      "@errtraq/queue-memory": ["packages/adapters/queue-memory/src/index.ts"],
      "@errtraq/queue-memory/stack": [
        "packages/adapters/queue-memory/src/stack.ts"
      ],
      "@errtraq/blob-fs": ["packages/adapters/blob-fs/src/index.ts"],
      "@errtraq/blob-fs/stack": ["packages/adapters/blob-fs/src/stack.ts"],
      "@errtraq/kv-memory": ["packages/adapters/kv-memory/src/index.ts"],
      "@errtraq/kv-memory/stack": ["packages/adapters/kv-memory/src/stack.ts"],
      "@errtraq/platform-standalone": [
        "packages/platforms/standalone/src/index.ts"
      ],
      "@errtraq/platform-standalone/stack": [
        "packages/platforms/standalone/src/stack.ts"
      ],
      "@errtraq/store-dynamodb": [
        "packages/adapters/store-dynamodb/src/index.ts"
      ],
      "@errtraq/store-dynamodb/stack": [
        "packages/adapters/store-dynamodb/src/stack.ts"
      ],
      "@errtraq/queue-sqs": ["packages/adapters/queue-sqs/src/index.ts"],
      "@errtraq/queue-sqs/stack": ["packages/adapters/queue-sqs/src/stack.ts"],
      "@errtraq/blob-s3": ["packages/adapters/blob-s3/src/index.ts"],
      "@errtraq/blob-s3/stack": ["packages/adapters/blob-s3/src/stack.ts"],
      "@errtraq/kv-dynamodb": ["packages/adapters/kv-dynamodb/src/index.ts"],
      "@errtraq/kv-dynamodb/stack": [
        "packages/adapters/kv-dynamodb/src/stack.ts"
      ],
      "@errtraq/platform-aws-lambda": [
        "packages/platforms/aws-lambda/src/index.ts"
      ],
      "@errtraq/platform-aws-lambda/stack": [
        "packages/platforms/aws-lambda/src/stack.ts"
      ]
    }
  },
  "include": ["packages/core/src/**/*.ts", "packages/http/src/**/*.ts"]
}
