        "packages/adapters/store-sql/src/postgres-stack.ts"
      ],
      "@moriyoshi/errtraq-core/runtime": ["packages/core/src/runtime.ts"]
    }
  },
  "include": ["packages/core/src/**/*.ts", "packages/http/src/**/*.ts"]
